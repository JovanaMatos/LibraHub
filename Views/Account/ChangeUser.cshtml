@model LibraHub.Models.ChangeUserViewModel

@{
    ViewData["Title"] = "Alterar Utilizador";
}

<h2>Alterar Utilizador</h2>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label">Primeiro Nome</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label">Último Nome</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Atualizar" class="btn btn-primary" />
            </div>
            <div class="form-group">
                <a asp-action="ChangePassword" asp-controller="Account">Alterar Palavra-passe</a>
            </div>
            @if (ViewBag.UserMessage != null)
            {
                <div class="form-group">
                    <span class="text-success">@ViewBag.UserMessage</span>
                </div>
            }
        </form>
    </div>
</div>
