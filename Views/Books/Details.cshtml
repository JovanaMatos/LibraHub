@model LibraHub.Data.Entities.Book

@{
    ViewData["Title"] = "Detalhes do Livro";
}

<h2>Detalhes do Livro</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-2">Autor</dt>
        <dd class="col-sm-10">
            @if (Model.Author != null)
            {
                @Model.Author.FullName
            }
        </dd>

        <dt class="col-sm-2">Género</dt>
        <dd class="col-sm-10">
            @if (Model.Genre != null)
            {
                @Model.Genre.Name
            }
        </dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Stock)</dd>

        <dt class="col-sm-2">Imagem</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)"
                     alt="@Model.Title"
                     style="width:200px;max-width:100%;height:auto;" />
            }
        </dd>
    </dl>
</div>

<div>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">
        <i class="fas fa-edit"></i> Editar
    </a>
    <a class="btn btn-secondary" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Voltar à Lista
    </a>
</div>
