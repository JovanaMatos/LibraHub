@model LibraHub.Data.Entities.Loan

@{
    ViewData["Title"] = "Apagar Empréstimo";
}

<h2>Apagar Empréstimo</h2>

<h3>Tem a certeza que deseja apagar este registo?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Livro</dt>
        <dd class="col-sm-9">
            @if (Model.Book != null)
            {
                @Model.Book.Title
            }
        </dd>

        <dt class="col-sm-3">Data de Empréstimo</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LoanDate)</dd>

        <dt class="col-sm-3">Data de Devolução Prevista</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DueDate)</dd>

        <dt class="col-sm-3">Data de Devolução</dt>
        <dd class="col-sm-9">
            @if (Model.ReturnDate.HasValue)
            {
                @Html.DisplayFor(model => model.ReturnDate)
            }
            else
            {
                <span>Ainda não devolvido</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Apagar" class="btn btn-danger" />
        <a class="btn btn-secondary" asp-action="Index">
            <i class="fas fa-arrow-left"></i> Voltar à Lista
        </a>
    </form>
</div>
