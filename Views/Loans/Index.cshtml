@model IEnumerable<LibraHub.Data.Entities.Book>

@{
    ViewData["Title"] = "Empréstimos";
}

<h2>Empréstimos</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="ActiveLoans" class="btn btn-info"><i class="fas fa-list"></i> Ver Empréstimos Ativos</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Imagem</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Género</th>
            <th>Disponibilidade</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Url.Content(item.ImageUrl)"
                             alt="@item.Title"
                             style="width:60px;max-width:100%;height:auto;" />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @if (item.Author != null)
                    {
                        @item.Author.FullName
                    }
                </td>
                <td>
                    @if (item.Genre != null)
                    {
                        @item.Genre.Name
                    }
                </td>
                <td>
                    @if (item.Stock > 0)
                    {
                        <span class="badge badge-success">@item.Stock disponível(is)</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Indisponível</span>
                    }
                </td>
                <td class="text-right">
                    @if (item.Stock > 0)
                    {
                        <a class="btn btn-primary" asp-action="Create" asp-route-bookId="@item.Id">
                            <i class="fas fa-book"></i> Emprestar
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled>
                            <i class="fas fa-book"></i> Emprestar
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
