@model LibraHub.Data.Entities.Author

@{
    ViewData["Title"] = "Detalhes do Autor";
}

<h2>Detalhes do Autor</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Primeiro Nome</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FirstName)</dd>

        <dt class="col-sm-2">Último Nome</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LastName)</dd>

        <dt class="col-sm-2">Imagem</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)"
                     alt="@Model.FullName"
                     style="width:200px;max-width:100%;height:auto;" />
            }
        </dd>
    </dl>
</div>

<div>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">
        <i class="fas fa-edit"></i> Editar
    </a>
    <a class="btn btn-secondary" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Voltar à Lista
    </a>
</div>
